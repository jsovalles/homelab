# Secrets – never commit decrypted material
*.dec.yaml
*.dec
.env
age.key
keys.txt
secrets.example.local.yaml

# OpenTofu / Terraform
infrastructure/terraform/.terraform/
infrastructure/terraform/*.tfplan
infrastructure/terraform/tfplan*
# scratch `make test` workspace state
infrastructure/terraform/terraform.tfstate.d/
infrastructure/terraform/crash.log
# State is encrypted with OpenTofu state encryption and CAN be committed.
# Remove the next line if you prefer to keep state out of git.
# infrastructure/terraform/terraform.tfstate*
infrastructure/terraform/*.tfstate.*backup

# Ansible (inventories are generated from terraform.tfvars by scripts/inventory.sh)
infrastructure/ansible/inventory/prod.yml
infrastructure/ansible/inventory/test.yml
infrastructure/ansible/.cache/
*.retry
.venv/
infrastructure/ansible/.ansible/

# Agent skills (local tooling)
.agents/
.claude/
skills-lock.json
agent/

# Python bytecode
__pycache__/
*.pyc
