# Managed by Ansible
auto lo
iface lo inet loopback

iface {{ pve_host_bridge_port }} inet manual

auto vmbr0
iface vmbr0 inet static
	address {{ pve_host_address }}
	gateway {{ pve_host_gateway }}
	bridge-ports {{ pve_host_bridge_port }}
	bridge-stp off
	bridge-fd 0

source /etc/network/interfaces.d/*
