# {{ ansible_managed }}
# Routes from the service catalog (group_vars/all/services.yml)
http:
  routers:
{% for s in _traefik_routes %}
    {{ s.name }}:
      rule: "Host(`{{ s.subdomain }}.{{ traefik_domain }}`)"
      entryPoints:
        - https
      service: {{ s.service | default(s.name) }}
{% if s.middlewares | default([]) | length > 0 %}
      middlewares: {{ s.middlewares | to_json }}
{% endif %}
{% endfor %}

  services:
{% for s in _traefik_routes if s.service is not defined %}
    {{ s.name }}:
      loadBalancer:
        servers:
{% for u in s.urls %}
          - url: "{{ u }}"
{% endfor %}
{% if s.urls | length > 1 %}
        # several servers (e.g. every Proxmox node): skip a down one, keep a browser on one node
        healthCheck:
          path: "{{ s.health_path | default(traefik_health_path) }}"
          interval: 30s
          timeout: 5s
        sticky:
          cookie:
            name: "{{ s.name }}_server"
            # also used by the plain-HTTP home.arpa route; the cookie only names a backend
            secure: false
            httpOnly: true
{% endif %}
{% if s.insecure_tls | default(false) %}
        serversTransport: insecureTransport
{% endif %}
{% endfor %}

  serversTransports:
    insecureTransport:
      insecureSkipVerify: true
