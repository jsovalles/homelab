# {{ ansible_managed }}
# Source: ansible/inventory/group_vars/docker_hosts/main.yml (homelab_env; secrets from homelab_secrets)
# Values are single-quoted (literal for compose); ones containing ' are double-quoted with \ " $ escaped.
{% for key, value in homelab_env | dictsort %}
{% set v = value | string %}
{% if '\n' in v %}{{ undef('homelab_env.' ~ key ~ ' contains a newline, which .env cannot hold') }}{% endif %}
{% if "'" not in v %}
{{ key }}='{{ v }}'
{% else %}
{{ key }}="{{ v | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '$$') }}"
{% endif %}
{% endfor %}
