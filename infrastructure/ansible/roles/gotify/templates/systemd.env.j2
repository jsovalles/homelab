# {{ ansible_managed }}
# Gotify v3 settings (it no longer reads config.yml). Read by systemd (EnvironmentFile), root only.
GOTIFY_SERVER_PORT={{ gotify_port }}
GOTIFY_DATABASE_DIALECT=sqlite3
GOTIFY_DATABASE_CONNECTION=data/gotify.db
GOTIFY_UPLOADEDIMAGESDIR=data/images
GOTIFY_PLUGINSDIR=data/plugins
# Only used when Gotify creates its database; the role reconciles an existing admin password
GOTIFY_DEFAULTUSER_NAME={{ gotify_admin_user | to_json(ensure_ascii=False) }}
GOTIFY_DEFAULTUSER_PASS={{ gotify_admin_password | to_json(ensure_ascii=False) }}
