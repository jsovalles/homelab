{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":semanticCommits", ":dependencyDashboard", "helpers:pinGitHubActionDigests"],
  timezone: "America/Bogota",
  "pre-commit": { enabled: true },
  schedule: ["before 6am on saturday"],
  // Every bump must pass `make lint` in CI and is verified with `make test` before merging.
  packageRules: [
    {
      description: "Group Ansible Python deps; CI fails until `make lock` regenerates requirements.lock",
      matchManagers: ["pip_requirements"],
      matchFileNames: ["infrastructure/ansible/requirements.txt"],
      groupName: "ansible python deps",
    },
    {
      description: "Provider bumps are behaviour changes: never automerge",
      matchManagers: ["terraform"],
      automerge: false,
    },
    {
      description: "docker/ stack: images pinned to version@digest, minor/patch/digest bumps in one weekly PR",
      matchManagers: ["docker-compose"],
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest"],
      groupName: "docker stack",
    },
    {
      description: "Patch and digest bumps of the stack merge themselves once CI is green",
      matchManagers: ["docker-compose"],
      matchUpdateTypes: ["patch", "digest", "pinDigest"],
      automerge: true,
    },
    {
      description: "Major bumps: one PR each, never automerged (read the migration notes)",
      matchManagers: ["docker-compose"],
      matchUpdateTypes: ["major"],
      automerge: false,
    },
    {
      description: "OpenTofu is pinned in bootstrap.sh and CI (found by two managers): one PR",
      matchPackageNames: ["opentofu", "opentofu/opentofu"],
      groupName: "opentofu",
    },
    {
      description: "TFLint: setup-tflint input + the annotated version: one PR",
      matchPackageNames: ["tflint", "terraform-linters/tflint"],
      groupName: "tflint",
    },
    {
      description: "Proxmox provider: constraint + lock file in one PR (test with make test before merging)",
      matchManagers: ["terraform"],
      matchDepNames: ["proxmox"],
      groupName: "proxmox provider",
    },
    {
      description: "required_version targets OpenTofu, not HashiCorp Terraform releases",
      matchManagers: ["terraform"],
      matchDepNames: ["hashicorp/terraform"],
      enabled: false,
    },
    {
      description: "CI Python: stay on versions ansible-core supports as a controller (raise deliberately)",
      matchDepNames: ["python"],
      allowedVersions: "<3.15",
    },
  ],
  customManagers: [
    {
      description: "Versions annotated with `# renovate: datasource=... depName=...`",
      customType: "regex",
      managerFilePatterns: ["/^scripts/.+\\.sh$/", "/\\.tfvars$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+=\"(?<currentValue>[^\"]+)\"",
      ],
    },
    {
      description: "YAML keys annotated with `# renovate: ...` (Ansible role defaults, workflow inputs)",
      customType: "regex",
      managerFilePatterns: ["/^infrastructure/ansible/roles/.+/defaults/main\\.yml$/", "/^\\.github/workflows/.+\\.ya?ml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[\\w-]+: \"?(?<currentValue>[^\"\\s]+)\"?",
      ],
    },
    {
      description: "Docker images run from workflow `run:` steps",
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/.+\\.ya?ml$/"],
      matchStrings: ["docker run [^\\n]*?(?<depName>ghcr\\.io/[\\w./-]+):(?<currentValue>v[\\w.]+)"],
      datasourceTemplate: "docker",
    },
  ],
}
