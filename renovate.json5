{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":semanticCommits", ":dependencyDashboard", "helpers:pinGitHubActionDigests"],
  timezone: "America/Bogota",
  "pre-commit": { enabled: true },
  schedule: ["before 6am on saturday"],
  // Every bump must pass `make lint` in CI and is verified with `make test` before merging.
  packageRules: [
    {
      description: "Group Ansible Python deps; CI fails until `make lock` regenerates requirements.lock",
      matchManagers: ["pip_requirements"],
      matchFileNames: ["infrastructure/ansible/requirements.txt"],
      groupName: "ansible python deps",
    },
    {
      description: "Provider bumps are behaviour changes: never automerge",
      matchManagers: ["terraform"],
      automerge: false,
    },
    {
      description: "docker/ stack tracks :latest + Watchtower…",
      matchManagers: ["docker-compose"],
      enabled: false,
    },
    {
      description: "…except deliberate major pins: new majors arrive as PRs (read the migration notes)",
      matchManagers: ["docker-compose"],
      matchPackageNames: ["traefik", "ghcr.io/wg-easy/wg-easy", "louislam/uptime-kuma"],
      enabled: true,
      automerge: false,
    },
  ],
  customManagers: [
    {
      description: "Versions annotated with `# renovate: datasource=... depName=...`",
      customType: "regex",
      managerFilePatterns: ["/^scripts/.+\\.sh$/", "/\\.tfvars$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+=\"(?<currentValue>[^\"]+)\"",
      ],
    },
    {
      description: "YAML keys annotated with `# renovate: ...` (Ansible role defaults, workflow inputs)",
      customType: "regex",
      managerFilePatterns: ["/^infrastructure/ansible/roles/.+/defaults/main\\.yml$/", "/^\\.github/workflows/.+\\.ya?ml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[\\w-]+: \"?(?<currentValue>[^\"\\s]+)\"?",
      ],
    },
    {
      description: "Docker images run from workflow `run:` steps",
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/.+\\.ya?ml$/"],
      matchStrings: ["docker run [^\\n]*?(?<depName>ghcr\\.io/[\\w./-]+):(?<currentValue>v[\\w.]+)"],
      datasourceTemplate: "docker",
    },
  ],
}
